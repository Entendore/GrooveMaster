<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="📚 Theory Library" android:textColor="@color/primary" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="Tap any entry for details — and to hear it." android:textColor="@color/textSecondary" android:textSize="13sp"/>
    <Spinner android:id="@+id/spinnerCat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
    <ListView android:id="@+id/listView" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="10dp" android:layout_weight="1" android:divider="@color/stepOff" android:dividerHeight="1dp"/>
</LinearLayout>
