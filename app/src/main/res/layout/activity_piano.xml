<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <Spinner android:id="@+id/spinnerPiano" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvPiano" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:lineSpacingExtra="3dp"
        android:textColor="@color/textPrimary" android:textSize="16sp"/>
    <com.example.groovemaster.PianoView android:id="@+id/pianoView"
        android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="12dp"/>
    <Button android:id="@+id/btnPianoEnd" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="🏁 Finish &amp; save score"/>
</LinearLayout>
