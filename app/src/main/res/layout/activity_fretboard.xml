<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <Spinner android:id="@+id/spinnerStrings" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.example.groovemaster.FretboardView android:id="@+id/fretView"
        android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="10dp"/>
    <TextView android:id="@+id/tvFret" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:lineSpacingExtra="3dp"
        android:textColor="@color/textPrimary" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button android:id="@+id/btnFretMode" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:text="🔀 Switch: What-note?"/>
        <Button android:id="@+id/btnFretEnd" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🏁 Finish"/>
    </LinearLayout>
</LinearLayout>
